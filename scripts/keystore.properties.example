# Copy this to keystore.properties at the repository root and fill in the values.
# 🔴 Never commit the real file (it is gitignored). Keep it mode 600.
# 🔑 Without this file, releases are signed with the debug key: installable on a device, but not
#    publishable.
storeFile=/absolute/path/to/your-upload-key.jks
storePassword=●●●
keyAlias=upload
keyPassword=●●●
